{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qec-atlas.local/schemas/corpus.schema.json",
  "title": "QEC Atlas Corpus v2 entry record",
  "type": "object",
  "required": [
    "schema",
    "id",
    "entry",
    "formal",
    "documents",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "qec-atlas-corpus-v2"},
    "id": {"type": "string", "pattern": "^entry:[a-z0-9_]+$"},
    "entry": {"$ref": "#/$defs/entry"},
    "formal": {"$ref": "#/$defs/formal"},
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/document"}
    },
    "provenance": {"$ref": "#/$defs/recordProvenance"}
  },
  "$defs": {
    "entryId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "formalAnchorId": {
      "type": "string",
      "pattern": "^formal:\\S+$"
    },
    "entry": {
      "type": "object",
      "required": ["id", "kind", "tier"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/entryId"},
        "kind": {"enum": ["family", "construction", "foundation"]},
        "tier": {"enum": ["T2", "T3", "gold"]}
      }
    },
    "formal": {
      "type": "object",
      "required": ["card", "instances", "formal_ir", "anchors"],
      "additionalProperties": false,
      "properties": {
        "card": {"type": "object", "minProperties": 1},
        "instances": {"type": "array", "items": {"type": "object"}},
        "formal_ir": {"$ref": "#/$defs/formalIrLinkset"},
        "construction_replay": {"$ref": "#/$defs/constructionReplay"},
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/formalAnchor"}
        }
      }
    },
    "formalAnchor": {
      "oneOf": [
        {"$ref": "#/$defs/entryAnchor"},
        {"$ref": "#/$defs/instanceAnchor"},
        {"$ref": "#/$defs/claimAnchor"},
        {"$ref": "#/$defs/constructionAnchor"}
      ]
    },
    "formalIrLinkset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "instances"],
      "properties": {
        "schema": {"const": "qec-atlas-formal-ir-linkset-v1"},
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "semantic_hash", "branch", "certificate_ids"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "semantic_hash": {"$ref": "#/$defs/sha256"},
              "branch": {
                "enum": [
                  "static-stabilizer",
                  "css-chain",
                  "subsystem-gauge",
                  "measurement-schedule"
                ]
              },
              "certificate_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^certificate:"}
              }
            }
          }
        }
      }
    },
    "entryAnchor": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/formalAnchorId"},
        "kind": {"const": "entry"}
      }
    },
    "instanceAnchor": {
      "type": "object",
      "required": ["id", "kind", "instance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/formalAnchorId"},
        "kind": {"const": "instance"},
        "instance": {"type": "string", "minLength": 1}
      }
    },
    "claimAnchor": {
      "type": "object",
      "required": ["id", "kind", "instance", "property"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/formalAnchorId"},
        "kind": {"const": "claim"},
        "instance": {"type": "string", "minLength": 1},
        "property": {"type": "string", "minLength": 1}
      }
    },
    "constructionAnchor": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/formalAnchorId"},
        "kind": {"const": "construction-replay"}
      }
    },
    "constructionReplay": {
      "type": "object",
      "required": ["schema", "operation", "matcher", "instances"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "qec-atlas-construction-replay-v1"},
        "operation": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        "matcher": {"const": "exact-checkmatrix-v1"},
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "params", "status"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "params": {"type": "object"},
              "status": {"const": "verified"}
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source",
        "formal_anchors",
        "chunks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^document:[^\\s#]+$"},
        "title": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "formal_anchors": {"$ref": "#/$defs/formalAnchorRefs"},
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/chunk"}
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": [
        "id",
        "anchor",
        "heading_path",
        "markdown",
        "formal_anchors",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^chunk:[^\\s#]+#[^\\s#]+$"},
        "anchor": {"type": "string", "minLength": 1},
        "heading_path": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "markdown": {"type": "string", "minLength": 1},
        "formal_anchors": {"$ref": "#/$defs/formalAnchorRefs"},
        "provenance": {"$ref": "#/$defs/chunkProvenance"}
      }
    },
    "formalAnchorRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/formalAnchorId"}
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/logicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceWithRole": {
      "type": "object",
      "required": ["role", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["card", "instances", "constructor"]},
        "path": {"$ref": "#/$defs/logicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "logicalPath": {
      "type": "string",
      "pattern": "^(atlas|constructions|foundations)/[^/]+/.+$"
    },
    "chunkProvenance": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/logicalPath"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recordProvenance": {
      "type": "object",
      "required": ["generator", "selection", "sources"],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": {
            "id": {"const": "qeclib.corpus"},
            "version": {"const": 2}
          }
        },
        "selection": {
          "type": "object",
          "required": ["minimum_tier"],
          "additionalProperties": false,
          "properties": {
            "minimum_tier": {"const": "T2"}
          }
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/sourceWithRole"}
        }
      }
    }
  }
}
