{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QEC Atlas card v0.3",
  "type": "object",
  "required": ["id", "kind", "identity", "presentation", "categories", "refs", "params", "tier"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "kind": {"enum": ["family", "construction", "foundation"]},
    "identity": {"$ref": "#/$defs/identity"},
    "presentation": {"$ref": "#/$defs/presentation"},
    "eczoo": {"$ref": "#/$defs/eczooMapping"},
    "description": {"type": "string", "minLength": 1},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "required": ["type", "description", "origin"], "additionalProperties": false,
        "properties": {
          "rung": {"enum": ["R1", "R2", "R3", "R4", "R5"]},
          "type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "dialect": {"enum": ["majorana-pairs", "parton", "quon"]},
          "description": {"type": "string", "minLength": 1},
          "origin": {"$ref": "#/$defs/viewOrigin"},
          "refs": {"type": "array", "items": {"type": "string"}},
          "gap": {"$ref": "#/$defs/wantedGap"}
        },
        "allOf": [
          {
            "if": {
              "required": ["type"],
              "properties": {"type": {"const": "fermionic"}}
            },
            "then": {"required": ["dialect"]},
            "else": {"not": {"required": ["dialect"]}}
          }
        ]
      }
    },
    "claim_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["property", "target"],
        "additionalProperties": false,
        "properties": {
          "property": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "target": {"$ref": "#/$defs/wantedTarget"}
        }
      }
    },
    "realizations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["platform", "status", "description", "refs"], "additionalProperties": false,
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "demonstrated"]},
          "description": {"type": "string", "minLength": 1},
          "refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "categories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "origin"], "additionalProperties": false,
        "properties": {"id": {"type": "string"}, "origin": {"$ref": "#/$defs/origin"}}
      }
    },
    "refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "params": {"type": "object"},
    "visual_instance": {"type": "string", "minLength": 1},
    "tier": {"enum": ["T0", "T1", "T2", "T3", "gold"]},
    "fit": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "platforms": {"type": "array", "items": {"type": "string"}},
        "tasks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decoders": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "status"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["standard", "research-grade", "none-known"]},
          "noise": {"type": "string"},
          "notes": {"type": "string", "minLength": 1},
          "refs": {"type": "array", "items": {"type": "string"}},
          "gap": {"$ref": "#/$defs/wantedGap"}
        },
        "allOf": [
          {
            "if": {"required": ["notes"]},
            "then": {
              "required": ["refs"],
              "properties": {"refs": {"minItems": 1}}
            }
          }
        ]
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["gate", "mechanism", "origin"], "additionalProperties": false,
        "properties": {
          "gate": {"type": "string"},
          "mechanism": {"enum": ["transversal", "fold-transversal", "surgery", "switching", "gauge-fixing", "braiding", "measurement-based"]},
          "level": {"type": "string"},
          "cost": {"type": "string"},
          "origin": {"$ref": "#/$defs/origin"}
        }
      }
    },
    "construction": {"$ref": "#/$defs/construction"},
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type", "target"], "additionalProperties": false,
        "properties": {
          "type": {"enum": ["special_case_of", "product_of", "dual_of", "gauge_fixes_to", "switchable_with", "floquetification_of", "concatenation_of", "same_bulk_phase_as"]},
          "target": {"type": "string"},
          "how": {"type": "string"},
          "refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": {"kind": {"enum": ["family", "construction"]}}
      },
      "then": {"required": ["eczoo"]}
    },
    {
      "if": {
        "required": ["kind", "eczoo"],
        "properties": {
          "kind": {"const": "construction"},
          "eczoo": {
            "required": ["status"],
            "properties": {"status": {"const": "mapped"}}
          }
        }
      },
      "then": {
        "properties": {
          "eczoo": {
            "properties": {"classification": {"const": "construction"}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["kind", "eczoo"],
        "properties": {
          "kind": {"const": "family"},
          "eczoo": {
            "required": ["status"],
            "properties": {"status": {"const": "mapped"}}
          }
        }
      },
      "then": {
        "properties": {
          "eczoo": {
            "properties": {
              "classification": {
                "enum": ["exact-family", "alias", "instance", "variant"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "eczooSourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "eczooCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "eczooDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "eczooSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eczooRepositoryUrl": {
      "const": "https://github.com/errorcorrectionzoo/eczoo_data"
    },
    "eczooCheckedSnapshot": {
      "type": "object",
      "required": ["repository_url", "commit", "retrieved_on"],
      "additionalProperties": false,
      "properties": {
        "repository_url": {"$ref": "#/$defs/eczooRepositoryUrl"},
        "commit": {"$ref": "#/$defs/eczooCommit"},
        "retrieved_on": {"$ref": "#/$defs/eczooDate"}
      }
    },
    "eczooMappedSource": {
      "type": "object",
      "required": [
        "repository_url",
        "commit",
        "retrieved_on",
        "path",
        "sha256",
        "page_url",
        "blob_url"
      ],
      "additionalProperties": false,
      "properties": {
        "repository_url": {"$ref": "#/$defs/eczooRepositoryUrl"},
        "commit": {"$ref": "#/$defs/eczooCommit"},
        "retrieved_on": {"$ref": "#/$defs/eczooDate"},
        "path": {
          "type": "string",
          "pattern": "^codes/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.ya?ml$"
        },
        "sha256": {"$ref": "#/$defs/eczooSha256"},
        "page_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "blob_url": {"type": "string", "pattern": "^https://[^\\s]+$"}
      }
    },
    "eczooMapping": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "zoo_id", "classification", "source"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "mapped"},
            "zoo_id": {"$ref": "#/$defs/eczooSourceId"},
            "classification": {
              "enum": ["exact-family", "alias", "instance", "variant", "construction"]
            },
            "source": {"$ref": "#/$defs/eczooMappedSource"}
          }
        },
        {
          "type": "object",
          "required": ["status", "checked_snapshot", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "no-page"},
            "checked_snapshot": {"$ref": "#/$defs/eczooCheckedSnapshot"},
            "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "required": ["canonical_name"],
      "additionalProperties": false,
      "properties": {
        "canonical_name": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilityTarget": {
      "type": "string",
      "pattern": "^(board:T[0-9]+|wanted:[a-z0-9_-]+)$"
    },
    "wantedTarget": {
      "type": "string",
      "pattern": "^wanted:[a-z0-9_-]+$"
    },
    "wantedGap": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": {"$ref": "#/$defs/wantedTarget"}
      }
    },
    "orientingView": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "kind"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "available"},
            "kind": {
              "enum": ["lattice", "schedule", "stabilizer-incidence", "construction"]
            }
          }
        },
        {
          "type": "object",
          "required": ["status", "target"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "planned"},
            "target": {"$ref": "#/$defs/capabilityTarget"}
          }
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "not-applicable"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "guidedTour": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {"status": {"const": "available"}}
        },
        {
          "type": "object",
          "required": ["status", "target"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "planned"},
            "target": {"$ref": "#/$defs/capabilityTarget"}
          }
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "not-applicable"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["status", "until_tier"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "not-required"},
            "until_tier": {"const": "T3"}
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "required": ["orienting_view", "guided_tour"],
      "additionalProperties": false,
      "properties": {
        "orienting_view": {"$ref": "#/$defs/orientingView"},
        "guided_tour": {"$ref": "#/$defs/guidedTour"}
      }
    },
    "construction": {
      "type": "object",
      "required": ["schema", "op", "inputs", "output", "match"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "qec-atlas-construction-v1"},
        "op": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/constructionFactor"},
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
        },
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "match": {"const": "exact-checkmatrix-v1"}
      }
    },
    "constructionFactor": {
      "type": "object",
      "required": ["ref", "params", "output"],
      "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "#/$defs/constructionFactorRef"},
        "params": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/constructionParam"}
        },
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "constructionFactorRef": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id", "version"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "generator"},
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "entry"},
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          }
        }
      ]
    },
    "constructionParam": {
      "oneOf": [
        {"$ref": "#/$defs/constructionBinding"},
        {"$ref": "#/$defs/constructionLiteral"}
      ]
    },
    "constructionBinding": {
      "type": "object",
      "required": ["instance_param"],
      "additionalProperties": false,
      "properties": {
        "instance_param": {"type": "string", "minLength": 1}
      }
    },
    "constructionLiteral": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/constructionLiteral"}
        }
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "verified"},
            "ref": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"},
            "iters": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["kind", "ref", "method", "seed", "iters"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "bounded"},
            "ref": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"},
            "iters": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "claimed"},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "curated"},
            "ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "viewOrigin": {
      "oneOf": [
        {
          "type": "object", "required": ["kind"], "additionalProperties": false,
          "properties": {"kind": {"const": "canonical"}}
        },
        {
          "type": "object", "required": ["kind", "converter", "version"], "additionalProperties": false,
          "properties": {
            "kind": {"const": "derived"},
            "converter": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "required": ["kind", "ref"], "additionalProperties": false,
          "properties": {
            "kind": {"const": "curated"},
            "ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
